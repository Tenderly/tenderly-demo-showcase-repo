# Copy to .env at the repo root and fill in. Never commit .env.
# Access key: Dashboard > Account Settings > Authorization. Account and project: dashboard.tenderly.co/{account}/{project}
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=

# Only for examples/monitoring/01-invariant-alerts: the id of a confirmed delivery channel (Alerts > Destinations)
TENDERLY_DELIVERY_CHANNEL_ID=
